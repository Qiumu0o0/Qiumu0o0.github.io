---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const renderedContent = await Astro.slots.render('default');
const headings = [...renderedContent.matchAll(/<h([23]) id="([^"]+)"[^>]*>(.*?)<\/h\1>/g)].map((match) => ({
  depth: Number(match[1]),
  slug: match[2],
  text: match[3].replace(/<[^>]+>/g, ''),
}));
const plainText = renderedContent.replace(/<[^>]+>/g, ' ');
const chineseCharacters = (plainText.match(/[\u3400-\u9fff]/g) || []).length;
const latinWords = plainText.replace(/[\u3400-\u9fff]/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(chineseCharacters / 300 + latinWords / 200));
const formatDate = (value: string | Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value));
const publishedDate = formatDate(frontmatter.pubDate);
const updatedDate = formatDate(frontmatter.updatedDate || frontmatter.pubDate);
---
<BaseLayout pageTitle={frontmatter.title}>
  <div class="article-ambient" style={`--hero-image:url("${frontmatter.image?.url || ''}")`} aria-hidden="true"></div>
  <main class="article-layout" style={`--hero-image:url("${frontmatter.image?.url || ''}")`}>
    <article class="article">
      {frontmatter.image?.url && <div class="hero-image"><img class="article-cover" src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} /><img class="article-cover-blur" src={frontmatter.image.url} alt="" aria-hidden="true" /></div>}

      <div class="article-meta">
        <span class="article-date"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg><time datetime={new Date(frontmatter.pubDate).toISOString()}>{publishedDate}</time><span>/ Update {updatedDate}</span></span>
        <span class="article-reading"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{readingMinutes} min read</span>
        {(frontmatter.tags || []).length > 0 && <span class="article-tagline"># {(frontmatter.tags || []).join(' / ')}</span>}
      </div>

      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <blockquote>“{frontmatter.description}”</blockquote>}
      <hr class="article-divider" />
      <div class="article-body" set:html={renderedContent} />
    </article>

    <aside class="toc" aria-label="Table of contents">
      <h2>TABLE OF CONTENTS</h2>
      <ol>
        {headings.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ol>
    </aside>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.article-body pre').forEach((block) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = '复制';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(block.querySelector('code')?.textContent ?? '');
      button.textContent = '已复制';
      window.setTimeout(() => { button.textContent = '复制'; }, 1500);
    });
    block.append(button);
  });
</script>

<style>
  :global(html) { background:linear-gradient(to bottom,#fff8ef 0%,#fbfaf9 46%,#ffffff 100%) fixed; }
  :global(html.dark) { background:linear-gradient(to bottom,#211b17 0%,#151214 46%,#0f0e10 100%) fixed; }
  .article-ambient { position:fixed; z-index:0; inset:0; width:100vw; height:100vh; background-image:var(--hero-image); background-position:center 18%; background-size:cover; opacity:.46; filter:blur(105px) saturate(1.35); transform:scale(1.22); transform-origin:center top; -webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 62%,transparent 100%); mask-image:linear-gradient(to bottom,#000 0%,#000 62%,transparent 100%); pointer-events:none; }
  :global(.site-header), .article-layout, :global(.site-footer) { position:relative; z-index:1; }
  .article-layout { position:relative; left:50%; isolation:isolate; width:min(calc(100vw - 40px),1000px); display:grid; grid-template-columns:minmax(0,720px) 190px; justify-content:space-between; gap:40px; padding:24px 0 60px; transform:translateX(-50%); }
  .toc { position:sticky; z-index:1; top:96px; grid-column:2; grid-row:1; align-self:start; max-height:calc(100vh - 128px); overflow-y:auto; padding-top:4px; }
  .toc h2 { margin:0 0 20px; color:var(--text); font-size:.92rem; font-weight:650; letter-spacing:.02em; }
  .toc ol { display:flex; flex-direction:column; gap:8px; margin:0; padding:0; list-style:none; }
  .toc li.nested { padding-left:12px; }
  .toc a { color:var(--muted); font-size:.9rem; line-height:1.45; text-decoration:none; }
  .toc a:hover { color:var(--text); }
  .article { position:relative; z-index:1; min-width:0; grid-column:1; grid-row:1; }
  .hero-image { position:relative; width:100%; margin-bottom:32px; }
  .article-cover { position:relative; z-index:1; width:100%; aspect-ratio:1200 / 630; display:block; border-radius:16px; object-fit:cover; }
  .article-cover-blur { position:absolute; inset:18px 0 -10px; width:100%; height:100%; border-radius:24px; object-fit:cover; opacity:.62; filter:blur(30px) saturate(1.12); }
  .article-meta { display:flex; flex-wrap:wrap; align-items:center; gap:8px 22px; width:100%; color:var(--muted); font-family:"Century Gothic",ui-sans-serif,system-ui,sans-serif; font-size:.8rem; }
  .article-date { display:inline-flex; align-items:center; gap:6px; }.article-date svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .article-reading { display:inline-flex; align-items:center; gap:5px; }
  .article-reading svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .article-tagline { display:inline-flex; align-items:center; }
  .article h1 { width:100%; margin:34px 0 10px; font-family:"Century Gothic",ui-sans-serif,system-ui,sans-serif; font-size:clamp(1.75rem,3.4vw,2.25rem); font-weight:500; line-height:1.2; letter-spacing:-.025em; }
  .article > blockquote { width:100%; margin:0 0 34px; padding:0; border:0; color:var(--muted); font-size:1rem; font-style:italic; }
  .article-divider { width:44%; margin:0 0 32px; border:0; border-top:1px solid var(--line); }
  .article-body { width:100%; color:var(--muted); font-size:1rem; line-height:1.8; }
  .article-body :global(:where(p,li,blockquote,figcaption,td,th,a,strong,em,code)) { color:var(--muted); }
  :global(html:not(.dark)) .article-body,
  :global(html:not(.dark)) .article-body :global(:where(p,li,blockquote,figcaption,td,th,a,strong,em,code)) { color:#3f4d61; }
  .article-body :global(h1) { margin:42px 0 14px; color:var(--text); font-size:1.75rem; }
  .article-body :global(h2) { margin:42px 0 14px; color:var(--text); font-size:1.45rem; }
  .article-body :global(h3) { margin:30px 0 12px; color:var(--text); font-size:1.15rem; }
  .article-body :global(p) { margin:0 0 1.15em; color:var(--muted); text-indent:2em; }
  .article-body :global(a) { text-underline-offset:3px; }
  .article-body :global(a:hover) { color:var(--text); }
  .article-body :global(img) { max-width:100%; border-radius:10px; }
  .article-body :global(code) { padding:.12em .35em; border-radius:4px; background:var(--wash-hover); }
  .article-body :global(pre) { position:relative; overflow:auto; padding:18px; border:1px solid var(--line); border-radius:8px; }
  .article-body :global(pre code) { padding:0; background:transparent; }
  .article-body :global(.code-copy) { position:absolute; top:8px; right:8px; padding:4px 9px; border:1px solid var(--line); border-radius:5px; background:var(--surface); color:var(--text); cursor:pointer; }
  .article-body :global(hr) { width:100%; margin:32px 0; border:0; border-top:1px solid var(--line); }
  @media (min-width:761px) { .article-layout { width:min(calc(100vw - 40px),1024px); transform:translateX(-50%) translateX(-12px); } }
  @media (max-width:760px) { .article-layout { left:0; width:100%; grid-template-columns:1fr; transform:none; }.article { grid-column:1; grid-row:1; }.toc { display:none; }.article-cover { border-radius:10px; } }
</style>
