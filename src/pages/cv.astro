---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="CV · 秋木">
  <main class="cv-page">
    <section>
      <h2>教学</h2>
      <p><a href="/cv/teaching/linear-algebra-ii/">2026秋西安交通大学线性代数II，助教</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .cv-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; text-align:left; }
  h2 { margin:0 0 12px; font-size:1.4rem; font-weight:500; }
  p { margin:0; color:var(--muted); }
  a { color:inherit; text-underline-offset:3px; }
</style>
