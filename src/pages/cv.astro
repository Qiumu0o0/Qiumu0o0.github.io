---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as CvContent, frontmatter as cv } from '../content/cv/index.md';
---

<BaseLayout pageTitle={cv.pageTitle}>
  <main class="cv-page">
    <section><CvContent /></section>
  </main>
</BaseLayout>

<style>
  .cv-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; text-align:left; }
  .cv-page :global(h2) { margin:0 0 12px; font-size:1.4rem; font-weight:500; }
  .cv-page :global(p) { margin:0; color:var(--muted); }
  .cv-page :global(a) { color:inherit; text-underline-offset:3px; }
</style>
