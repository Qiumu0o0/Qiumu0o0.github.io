---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const postModules = import.meta.glob('../pages/posts/**/*.md', { eager: true });
const categories = [
  { folder: 'AcademicTech', slug: 'academic-tech', label: 'Academic & Tech' },
  { folder: 'PersonalGrowth', slug: 'personal-growth', label: 'Personal Growth' },
  { folder: 'Readings', slug: 'readings', label: 'Readings' },
  { folder: 'Toys', slug: 'toys', label: 'Toys' },
];
const allPosts = Object.entries(postModules)
  .map(([path, post]: [string, any]) => ({
    ...post,
    category: categories.find(({ folder }) => path.includes(`/posts/${folder}/`))?.slug,
  }))
  .sort((a: any, b: any) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
const pageTitle = 'Blog · 秋木';
const getReadingMinutes = (content = '') => {
  const chineseCharacters = (content.match(/[\u3400-\u9fff]/g) || []).length;
  const latinWords = content.replace(/[\u3400-\u9fff]/g, ' ').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(chineseCharacters / 300 + latinWords / 200));
};
---
<BaseLayout pageTitle={pageTitle}>
  <main class="blog-page">
    <header class="blog-heading"><h1>All</h1><p>Page 1 - Showing {Math.min(15, allPosts.length)} of {allPosts.length} posts</p></header>

    <nav class="category-nav" aria-label="Blog collections">
      <a class="active" href="/blog/">All</a>
      {categories.map((category) => <a href={`/blog/${category.slug}/`}>{category.label}</a>)}
    </nav>

    <div class="blog-layout">
      <section class="post-feed" aria-label="文章列表">
        {allPosts.map((post: any) => (
          <BlogPost
            url={post.url}
            title={post.frontmatter.title}
            description={post.frontmatter.description}
            pubDate={post.frontmatter.pubDate}
            readingMinutes={getReadingMinutes(post.rawContent?.() || '')}
            tags={post.frontmatter.tags || []}
            image={post.frontmatter.image?.url}
          />
        ))}
      </section>

      <aside class="blog-sidebar" aria-label="博客归档">
        <section class="sidebar-panel">
          <h2><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1.5"/><ellipse cx="12" cy="12" rx="9" ry="3.8"/><ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(120 12 12)"/></svg>Collections</h2>
          <div class="collection-list">
            <a class="collection-card" href="/blog/">
              <strong>All</strong>
              <small>{allPosts.length} posts</small>
            </a>
            {categories.map((category) => (
              <a class="collection-card" href={`/blog/${category.slug}/`}>
                <strong>{category.label}</strong>
                <small>{allPosts.filter((post: any) => post.category === category.slug).length} posts</small>
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .category-nav { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 24px -24px; }
  .category-nav a { padding:6px 12px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:.8rem; text-decoration:none; }
  .category-nav a:hover,.category-nav a.active { border-color:var(--accent); color:var(--text); background:var(--wash-hover); }
  .collection-list { display:flex; flex-direction:column; gap:8px; }
  @media (max-width:760px) { .category-nav { margin-left:0; } }
</style>
