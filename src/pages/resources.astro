---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as ResourcesContent, frontmatter as resources } from '../content/resources.md';
---

<BaseLayout pageTitle={resources.pageTitle}>
  <main class="resources-page">
    <ResourcesContent />
  </main>
</BaseLayout>

<style>
  .resources-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; }
  .resources-page :global(h1) { margin:0 0 18px; }
  .resources-page :global(ul) { margin:0; padding-left:1.25rem; }
  .resources-page :global(li + li) { margin-top:8px; }
  .resources-page :global(a) { color:var(--muted); text-underline-offset:3px; }
  .resources-page :global(a:hover) { color:var(--text); }
</style>
