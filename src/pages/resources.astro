---
import BaseLayout from '../layouts/BaseLayout.astro';
import sequence1Url from './resources/数列选讲1.pdf?url';
import sequence2Url from './resources/数列选讲2.pdf?url';
import sequence3Url from './resources/数列选讲3.pdf?url';
---

<BaseLayout pageTitle="资料 | 秋木的小站">
  <main class="resources-page">
    <h1>资料</h1>
    <ul>
      <li><a href={sequence1Url}>数列选讲 1</a></li>
      <li><a href={sequence2Url}>数列选讲 2</a></li>
      <li><a href={sequence3Url}>数列选讲 3</a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  .resources-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; }
  h1 { margin:0 0 18px; }
  ul { margin:0; padding-left:1.25rem; }
  li + li { margin-top:8px; }
  a { color:var(--muted); text-underline-offset:3px; }
  a:hover { color:var(--text); }
</style>
