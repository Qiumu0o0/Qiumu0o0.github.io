---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Content as CourseContent, frontmatter as course } from '../../../content/cv/teaching/linear-algebra-ii.md';
---

<BaseLayout pageTitle={course.pageTitle}>
  <main class="course-page">
    <CourseContent />
  </main>
</BaseLayout>

<style>
  .course-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; }
  .course-page :global(h1) { margin:0 0 28px; font-size:1.65rem; font-weight:500; }
  .course-page :global(h2) { margin:0 0 12px; font-size:1.15rem; font-weight:500; }
  .course-page :global(ul) { margin:0; padding-left:1.25rem; }
  .course-page :global(a) { color:var(--muted); text-underline-offset:3px; }
  .course-page :global(a:hover) { color:var(--text); }
</style>
