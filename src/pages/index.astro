---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as HomeContent, frontmatter as home } from '../content/home.md';
---

<BaseLayout pageTitle={home.pageTitle}>
  <main class="home">
    <section class="profile" aria-labelledby="profile-name">
      <img class="avatar" src={home.avatar} alt={`${home.name}的头像`} />
      <div>
        <h1 id="profile-name">{home.name}</h1>
        <p class="name-note">{home.nameNote}<br />{home.aaronIntro} <a href={home.aaronUrl}>{home.aaronName}</a>.</p>
        <div class="social-links" aria-label="Profile links">
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>{home.location}</span>
          <a href={home.githubUrl} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>{home.githubLabel}</a>
          <a href={`mailto:${home.email}`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>{home.emailLabel}</a>
          <a href={home.scholarUrl} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-5 9 5-9 5-9-5Z"/><path d="M7 12v5c3 2 7 2 10 0v-5"/></svg>{home.scholarLabel}</a>
        </div>
      </div>
    </section>
    <section class="content-block about-section">
      <h2>{home.aboutTitle}</h2>
      <div class="about-copy"><HomeContent /><a class="text-link" href="/about/">{home.aboutLinkLabel}</a></div>
    </section>
    <section class="content-block education-section">
      <h2>{home.educationTitle}</h2>
      <div class="education-list">
        {home.education.map((school) => (
          <a class="education-card" href={school.url} target="_blank" rel="noreferrer">
            <h3>{school.name}</h3><p>{school.program}</p>
            <div class="education-meta"><span><time>{school.dates}</time>, {school.location}</span></div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
