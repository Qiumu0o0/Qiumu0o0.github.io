---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as AboutContent } from '../content/about.md';
---

<BaseLayout pageTitle="About · 秋木">
  <main class="about-page">
    <p class="eyebrow">About</p>
    <div class="about-content"><AboutContent /></div>
  </main>
</BaseLayout>

<style>
  .about-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; text-align:left; }
  .eyebrow { margin:0 0 12px; color:var(--muted); font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; }
  .about-content { width:100%; }
  .about-content :global(h1) { margin:0; font-size:clamp(2rem,5vw,3rem); font-weight:500; letter-spacing:-.03em; }
  .about-content :global(p) { margin:16px 0 28px; color:var(--muted); }
  .about-content :global(a) { display:inline-flex; gap:8px; align-items:center; padding:7px 12px; border:1px solid var(--line); border-radius:6px; color:var(--text); font-size:.9rem; text-decoration:none; transition:background .2s,border-color .2s; }
  .about-content :global(a:hover) { border-color:#ffffff45; background:#ffffff12; }
</style>
