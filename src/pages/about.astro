---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="About · 秋木">
  <main class="about-page">
    <p class="eyebrow">About</p>
    <h1>建设中...</h1>
    <p>关于我的更多内容，稍后见。</p>
    <a href="/">返回首页 <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>

<style>
  .about-page { min-height:65vh; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; max-width:680px; margin:auto; padding:48px 0 80px; }
  .eyebrow { margin:0 0 12px; color:var(--muted); font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; }
  h1 { margin:0; font-size:clamp(2rem,5vw,3rem); font-weight:500; letter-spacing:-.03em; }
  .about-page > p:not(.eyebrow) { margin:16px 0 28px; color:var(--muted); }
  a { display:inline-flex; gap:8px; align-items:center; padding:7px 12px; border:1px solid var(--line); border-radius:6px; color:var(--text); font-size:.9rem; text-decoration:none; transition:background .2s,border-color .2s; }
  a:hover { border-color:#ffffff45; background:#ffffff12; }
</style>
