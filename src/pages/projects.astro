---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as ProjectsContent, frontmatter as projects } from '../content/projects.md';
---
<BaseLayout pageTitle={projects.pageTitle}>
  <main class="projects-page"><ProjectsContent /></main>
</BaseLayout>

<style>
  .projects-page { position:relative; left:50%; width:min(calc(100vw - 40px),1000px); min-height:65vh; transform:translateX(-50%); padding:48px 0 80px; text-align:left; }
</style>
